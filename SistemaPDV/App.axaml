<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SistemaPDV.Converters"
             x:Class="SistemaPDV.App"
             xmlns:local="using:SistemaPDV"
             RequestedThemeVariant="Dark">
             <!-- Fixo em "Dark": o protótipo mockado do curso é um tema escuro único,
                  não segue o tema claro/escuro do sistema operacional. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SistemaPDV/Themes/PdvTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Globais porque SyncStatusIndicator é reaproveitado em várias telas
                 (Pdv, Cadastros, ListaPedidos) — cada uma usaria os mesmos dois. -->
            <conv:SyncStatusParaTextoConverter x:Key="SyncStatusParaTextoConverter" />
            <conv:SyncStatusParaCorConverter x:Key="SyncStatusParaCorConverter" />
            <conv:EstadoConexaoParaTextoConverter x:Key="EstadoConexaoParaTextoConverter" />
            <conv:EstadoConexaoParaCorConverter x:Key="EstadoConexaoParaCorConverter" />
            <conv:EstadoConexaoParaRotuloConverter x:Key="EstadoConexaoParaRotuloConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Estilos do visual do protótipo (botões, cards, pílulas): usam só os tokens do PdvTheme. -->
        <StyleInclude Source="avares://SistemaPDV/Themes/PdvStyles.axaml" />
    </Application.Styles>
</Application>