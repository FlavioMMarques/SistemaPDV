<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Estilos reutilizáveis do visual do protótipo (Fase 7). Só usam os tokens de Themes/PdvTheme.axaml — nenhuma cor ou
    raio cravado aqui. Classes: produto (card), primario (botão amarelo), secundario, fantasma, nav / nav.ativa (barra do
    topo), pill, tecla (chip de atalho). Foco por teclado sempre visível (borda amarela), como pede a acessibilidade.
  -->

  <!-- Card de produto -->
  <Style Selector="Button.produto">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.produto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Button.produto:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>

  <!-- Botão principal (amarelo) -->
  <Style Selector="Button.primario">
    <Setter Property="Background" Value="{DynamicResource BrandYellowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="0,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primario:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Botão secundário (contorno) -->
  <Style Selector="Button.secundario">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.secundario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>

  <!-- Botão discreto (sem fundo): remover item etc. -->
  <Style Selector="Button.fantasma">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.fantasma:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentRedDimBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
  </Style>

  <!-- Navegação da barra do topo: a aba da tela atual fica destacada (amarelo + contorno) -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
  </Style>
  <Style Selector="Button.nav.ativa /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <!-- Desabilitada (sem caixa aberto / venda em andamento): esmaecida e sem o fundo cinza do tema. A aba da tela ATUAL
       continua bem visível mesmo desabilitada — o operador precisa saber onde está. -->
  <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.nav.ativa:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandYellowBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Cartão de forma de pagamento (painel de pagamento): o escolhido fica com borda amarela e fundo âmbar -->
  <Style Selector="Button.opcao">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.opcao:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Button.opcao.selecionada /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Button.opcao:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>

  <!-- Pílula de status (sistema, conexão, sync) -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <!-- Pílula que é BOTÃO (a "Sync: N pendentes" da barra do topo, que abre o painel da fila outbox): mesma cara de Border.pill,
       mais o realce do mouse e o foco visível de teclado. -->
  <Style Selector="Button.pillBotao">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pillBotao:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Button.pillBotao:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>

  <!-- Chip de tecla de atalho ("F10") -->
  <Style Selector="Border.tecla">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="5,1" />
  </Style>


  <!-- Selo de sincronização (SeloSincronia): pílula com fundo suave na cor do estado -->
  <Style Selector="Border.selo">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.selo TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.selo.ok">
    <Setter Property="Background" Value="{DynamicResource AccentGreenDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}" />
  </Style>
  <Style Selector="Border.selo.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
  </Style>
  <Style Selector="Border.selo.pendente">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Border.selo.pendente TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Border.selo.falha">
    <Setter Property="Background" Value="{DynamicResource AccentRedDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
  </Style>
  <Style Selector="Border.selo.falha TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
  </Style>

  <!-- Chip discreto (forma de pagamento na tabela) -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Abas da tela de Cadastros (Produtos / Clientes / Operadores): a aba atual fica com contorno amarelo -->
  <Style Selector="Button.aba">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.aba:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
  </Style>
  <Style Selector="Button.aba.ativa /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandYellowBrush}" />
  </Style>

  <!-- Chip com cor (perfil do operador): amarelo para supervisor, azul para operador -->
  <Style Selector="Border.chip.supervisor">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Border.chip.supervisor TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="Border.chip.operador">
    <Setter Property="Background" Value="{DynamicResource AccentBlueDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
  </Style>
  <Style Selector="Border.chip.operador TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
  </Style>

  <!-- Cabeçalho de coluna de tabela (maiúsculas, pequeno, apagado) -->
  <Style Selector="TextBlock.colunaTitulo">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Aviso temporário (toast) no canto da tela. Entra esmaecendo e sobe um pouco; ao sair (classe "saindo") esmaece. Borda
       lateral colorida por tipo — a cor nunca é a única pista: cada aviso traz ícone e texto. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="10" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Faixa lateral colorida (só nos avisos de sucesso/erro; o neutro fica sem faixa). -->
  <Style Selector="Border.toastFaixa.sucesso">
    <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
  </Style>
  <Style Selector="Border.toastFaixa.erro">
    <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
  </Style>  <Style Selector="Border.toast.saindo">
    <Setter Property="Opacity" Value="0" />
  </Style>


  <!-- Combo de seleção (tela de Login): campo como os outros do app e lista aberta em cartão escuro. Global (e não na tela) porque a lista
       abre numa camada própria, fora da árvore da tela, e não recebe os estilos locais dela. Uso: <ComboBox Classes="campo"> -->
  <Style Selector="ComboBox.campo">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="10,8,12,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MaxDropDownHeight" Value="264" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox.campo:pointerover /template/ Border#Background, ComboBox.campo:focus /template/ Border#Background, ComboBox.campo:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandYellowBrush}" />
  </Style>
  <Style Selector="ComboBox.campo /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ComboBox.campo ComboBoxItem">
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
  </Style>
  <Style Selector="ComboBox.campo ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <Style Selector="ComboBox.campo ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandYellowDimBrush}" />
  </Style>
</Styles>
