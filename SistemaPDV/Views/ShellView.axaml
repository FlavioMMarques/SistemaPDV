<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SistemaPDV.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="SistemaPDV.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource BgMainBrush}">

  <DockPanel>

    <!-- Header: operador + caixa (protótipo mockado) + indicador de conexão (Task 50) —
         pendências ainda não têm indicador. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderColorBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="SoftcomPDV"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextMainBrush}"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- Indicador de conexão (Task 50): ícone + texto, nunca só cor. A dica mostra o
               motivo quando está offline (ex: URL sem HTTPS). -->
          <TextBlock Text="{Binding Conexao, Converter={StaticResource EstadoConexaoParaTextoConverter}}"
                     Foreground="{Binding Conexao, Converter={StaticResource EstadoConexaoParaCorConverter}}"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding DetalheConexao}"
                     AutomationProperties.Name="Estado da conexão com a API" />
          <TextBlock Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} • Cx {1}">
                <Binding Path="OperadorLogado.Nome" FallbackValue="" />
                <Binding Path="CaixaAberto.Id" FallbackValue="—" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Navegação persistente entre Dashboard/Nova Venda/Pedidos/Cadastros — habilitada com
         caixa aberto (ver ShellViewModel). Resolve o que ficou pendente nas Tasks
         42/43/45 sobre não ter como voltar depois de sair do Dashboard. Cadastros só
         exige operador logado (não depende de caixa aberto). -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderColorBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="📊 Painel"
                Command="{Binding IrParaDashboardCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                AutomationProperties.Name="Ir para o painel" />
        <Button Content="🛒 Nova Venda"
                Command="{Binding IrParaPdvCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                AutomationProperties.Name="Ir para nova venda" />
        <Button Content="📋 Pedidos"
                Command="{Binding IrParaListaPedidosCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                AutomationProperties.Name="Ir para lista de pedidos" />
        <Button Content="📇 Cadastros"
                Command="{Binding IrParaCadastrosCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                AutomationProperties.Name="Ir para cadastros" />
        <Button Content="🔒 Fechar caixa"
                Command="{Binding IrParaFecharCaixaCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                AutomationProperties.Name="Ir para fechar caixa" />
        <Button Content="⚙ Configurações"
                Command="{Binding IrParaConfiguracoesCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextMainBrush}"
                ToolTip.Tip="Exige a chave de um supervisor"
                AutomationProperties.Name="Ir para configurações" />
      </StackPanel>
    </Border>

    <!-- Falha inesperada de navegação (fire-and-forget capturado, ver
         docs/APRENDIZADOS.md e ShellViewModel.ExecutarComTratamentoDeErroAsync) —
         sem isso a tela travava sem nenhum aviso quando algo dava errado. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource AccentRedDimBrush}"
            BorderBrush="{StaticResource AccentRedBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8"
            IsVisible="{Binding Mensagem, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap" />
    </Border>

    <ContentControl Content="{Binding CurrentViewModel}" />

  </DockPanel>

</UserControl>
