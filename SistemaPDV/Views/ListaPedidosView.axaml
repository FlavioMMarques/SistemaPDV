<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SistemaPDV.ViewModels"
             xmlns:sales="using:SistemaPDV.Services.Sales"
             xmlns:controls="using:SistemaPDV.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SistemaPDV.Views.ListaPedidosView"
             x:DataType="vm:ListaPedidosViewModel"
             Background="{StaticResource BgMainBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Grid.Column="0" Text="📋 Listagem de Pedidos" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="🔁 Reenviar falhas"
                Command="{Binding ReenviarFalhasCommand}"
                Background="{StaticResource BgCardBrush}"
                Foreground="{StaticResource TextMainBrush}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="16,8"
                ToolTip.Tip="Devolve à fila de envio as vendas que falharam ou desistiram"
                AutomationProperties.Name="Reenviar vendas com falha" />
        <Button Content="🔄 Atualizar"
                Command="{Binding AtualizarCommand}"
                Background="{StaticResource BgCardBrush}"
                Foreground="{StaticResource TextMainBrush}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="16,8"
                AutomationProperties.Name="Atualizar lista de pedidos" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="{Binding MensagemReenvio}"
                 Foreground="{StaticResource TextMutedBrush}"
                 IsVisible="{Binding MensagemReenvio, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <!-- Resultado do descarte (também quando deu certo e o painel some). -->
      <TextBlock Text="{Binding MensagemDescarte}"
                 Foreground="{StaticResource TextMutedBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding MensagemDescarte, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderColorBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="8">
      <ListBox ItemsSource="{Binding Vendas}" SelectedItem="{Binding VendaSelecionada, Mode=TwoWay}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="sales:VendaResumo">
            <StackPanel Margin="4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Numero, StringFormat='#{0}', TargetNullValue='—'}" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMutedBrush}" Width="60" />
              <TextBlock Grid.Column="1" Text="{Binding DataHora, StringFormat='{}{0:dd/MM HH:mm}'}" Foreground="{StaticResource TextMutedBrush}" Width="110" />
              <TextBlock Grid.Column="2" Text="{Binding ClienteNome}" Foreground="{StaticResource TextMainBrush}" Margin="8,0" />
              <TextBlock Grid.Column="3" Text="{Binding OperadorNome}" Foreground="{StaticResource TextMutedBrush}" Width="120" />
              <TextBlock Grid.Column="4" Text="{Binding FormasPagamento}" Foreground="{StaticResource TextMutedBrush}" Width="120" />
              <TextBlock Grid.Column="5" Text="{Binding Total, StringFormat='R$ {0:F2}'}" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMainBrush}" Width="90" />
              <controls:SyncStatusIndicator Grid.Column="6" Status="{Binding SyncStatus}" />
            </Grid>
              <!-- Motivo da falha (e o aviso "parou de tentar") — sem isso um 🔴 seria indiagnosticável. -->
              <TextBlock Text="{Binding UltimoErroSync}"
                         Foreground="{StaticResource AccentRedBrush}"
                         FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding UltimoErroSync, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Descarte de venda EM FALHA (só aparece com uma delas selecionada): só supervisor, com motivo. A venda continua
         na lista como "⚫ Descartada" (auditoria) e deixa de travar o fechamento do caixa. -->
    <Border Grid.Row="3"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderColorBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="16" Margin="0,12,0,0"
            IsVisible="{Binding PodeDescartar}">
      <StackPanel Spacing="8">
        <TextBlock Text="🗑 Descartar venda em falha" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" />
        <TextBlock Text="{Binding TextoDescarte}"
                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding MotivoDescarte, Mode=TwoWay}"
                   PlaceholderText="Motivo do descarte (obrigatório)"
                   MaxLength="300"
                   Background="{StaticResource BgInputBrush}"
                   BorderBrush="{StaticResource BorderColorBrush}"
                   Foreground="{StaticResource TextMainBrush}"
                   CornerRadius="{StaticResource RadiusSmall}"
                   AutomationProperties.Name="Motivo do descarte" />
          <!-- Só aparece quando a política do app exige a chave (PoliticaSupervisor). -->
          <TextBox Grid.Column="1"
                   IsVisible="{Binding ExigeChave}"
                   Text="{Binding ChaveSupervisor, Mode=TwoWay}"
                   PasswordChar="●"
                   PlaceholderText="Chave do supervisor"
                   Background="{StaticResource BgInputBrush}"
                   BorderBrush="{StaticResource BorderColorBrush}"
                   Foreground="{StaticResource TextMainBrush}"
                   CornerRadius="{StaticResource RadiusSmall}"
                   AutomationProperties.Name="Chave do supervisor">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding DescartarCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2"
                  Content="Descartar"
                  Command="{Binding DescartarCommand}"
                  Background="{StaticResource AccentRedDimBrush}"
                  Foreground="{StaticResource AccentRedBrush}"
                  CornerRadius="{StaticResource RadiusMedium}"
                  Padding="16,8"
                  AutomationProperties.Name="Descartar venda" />
        </Grid>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
